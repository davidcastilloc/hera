{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "core:path:default",
    "core:resources:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:webview:deny-print",
    "core:webview:allow-set-webview-zoom",
    "shell:allow-open",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-ask",
    "fs:allow-lstat",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "opener:allow-reveal-item-in-dir",
    "os:allow-os-type",
    "process:allow-restart",
    "log:allow-log",
    "notification:default",
    "app-menu:allow-show",
    "app-menu:allow-hide",
    "app-menu:allow-show-window",
    "config:allow-get-storage-dir",
    "config:allow-set-config",
    "config:allow-get-config",
    "cover:allow-get-cover",
    "database:allow-scan-library",
    "database:allow-get-all-tracks",
    "database:allow-get-tracks",
    "database:allow-get-track",
    "database:allow-update-track",
    "database:allow-remove-tracks",
    "database:allow-get-artists",
    "database:allow-get-artist-tracks",
    "database:allow-get-compilation-albums",
    "database:allow-has-compilations",
    "database:allow-get-all-playlists",
    "database:allow-get-playlist",
    "database:allow-create-playlist",
    "database:allow-rename-playlist",
    "database:allow-set-playlist-tracks",
    "database:allow-export-playlist",
    "database:allow-delete-playlist",
    "database:allow-reset",
    "default-view:allow-set",
    "hera-dj:allow-compute-style-dna",
    "hera-dj:allow-export-crate",
    "hera-dj:allow-build-dj-set-spine",
    "hera-dj:allow-get-cloudflare-edge-radar",
    "hera-dj:allow-chat-copilot",
    "hera-dj:allow-probe-ai-backend",
    "hera-dj:allow-list-ai-backends",
    "hera-dj:allow-scan-ai-connectivity",
    "hera-dj:allow-cancel-library-scan",
    "hera-dj:allow-resolve-harmonic-bridge",
    "hera-dj:allow-download-p2p-track",
    "hera-dj:allow-set-mini-overlay-mode",
    "hera-dj:allow-push-virtualdj-live-crate",
    "hera-dj:allow-read-virtualdj-now-playing",
    "hera-dj:allow-native-audio-load-track",
    "hera-dj:allow-native-audio-play",
    "hera-dj:allow-native-audio-pause",
    "hera-dj:allow-native-audio-seek",
    "hera-dj:allow-native-audio-set-volume",
    "hera-dj:allow-native-audio-set-playback-rate",
    "hera-dj:allow-native-audio-get-state",
    "hera-dj:allow-subscribe-audio-telemetry",
    "hera-agent:allow-get-agent-runtime-status",
    "hera-agent:allow-list-agent-sessions",
    "hera-agent:allow-create-agent-session",
    "hera-agent:allow-update-agent-session",
    "hera-agent:allow-delete-agent-session",
    "hera-agent:allow-get-agent-session-messages",
    "hera-agent:allow-start-agent-turn",
    "hera-agent:allow-cancel-agent-turn",
    "hera-agent:allow-resolve-agent-approval",
    "sleepblocker:allow-enable",
    "sleepblocker:allow-disable",
    "mcp-bridge:default"
