{
  "tools": [
    {
      "description": "[MANDATORY STEP 0] Verify if Hera repository, native Rust binary (hera-node), Python environment, companion binaries (slskd, rclone, ffmpeg), and global AI agent skills are installed and updated to the latest version, auto-updating them if needed.",
      "inputSchema": {
        "properties": {
          "auto_compile_rust": {
            "default": true,
            "type": "boolean"
          },
          "pull_remote": {
            "default": true,
            "type": "boolean"
          },
          "sync_skills": {
            "default": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "ensure_hera_updated"
    },
    {
      "description": "Search acoustically verified studio masters on the Hera P2P Mesh by query, Camelot key, BPM range, or subgenre.",
      "inputSchema": {
        "properties": {
          "bpm_max": {
            "description": "Maximum BPM",
            "type": "number"
          },
          "bpm_min": {
            "description": "Minimum BPM",
            "type": "number"
          },
          "camelot": {
            "description": "Camelot key filter (e.g. '8A', '11B')",
            "type": "string"
          },
          "query": {
            "description": "Artist, title, or keyword query",
            "type": "string"
          },
          "subgenre": {
            "description": "Subgenre filter",
            "type": "string"
          },
          "verified_only": {
            "default": true,
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "name": "search_music"
    },
    {
      "description": "Get ranked P2P track candidates with transparent forensic score breakdown (bandwidth Hz, sub-bass phase correlation, quality score, and hera_seal).",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 10,
            "type": "integer"
          },
          "query": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "get_track_candidates"
    },
    {
      "description": "Run pure-Rust Symphonia + rustfft Zero-Trust spectral forensics (Fake Lossless, Sine Tone, <120Hz Sub-Bass Phase) and 4 Acoustic Hot Cues (1.1.1 Downbeat, Phrase In, Main Drop, Mix Out) + Camelot key + 64D Style Embedding.",
      "inputSchema": {
        "properties": {
          "bpm_hint": {
            "type": "number"
          },
          "claimed_ext": {
            "default": "flac",
            "type": "string"
          },
          "file_path": {
            "description": "Local path to WAV/FLAC/MP3/OGG file (native mode)",
            "type": "string"
          },
          "pcm_left": {
            "description": "Raw float32 PCM left channel samples",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "pcm_right": {
            "description": "Optional float32 PCM right channel samples",
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "sample_rate": {
            "default": 44100,
            "type": "integer"
          }
        },
        "type": "object"
      },
      "name": "analyze_track"
    },
    {
      "description": "Run batch pure-Rust DSP forensic and structural Hot-Cue analysis across multiple audio files.",
      "inputSchema": {
        "properties": {
          "bpm_hint": {
            "type": "number"
          },
          "file_paths": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "file_paths"
        ],
        "type": "object"
      },
      "name": "analyze_batch"
    },
    {
      "description": "Sequence a harmonic DJ crate using the 4-Layer Holistic Synergy Engine + Global 2-Opt TSP optimizer (Camelot wheel, gradual BPM + 3:4 polyrhythmic bridges, vocal clash avoidance, 64D style embeddings). Exports M3U8, Rekordbox XML, and Set Guide.",
      "inputSchema": {
        "properties": {
          "brief": {
            "description": "Set concept or brief",
            "type": "string"
          },
          "candidates": {
            "description": "Optional candidate tracks; if omitted, uses the node's verified catalog",
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "energy_arc": {
            "default": "steady_climb",
            "enum": [
              "steady_climb",
              "rollercoaster",
              "peak_hour"
            ],
            "type": "string"
          },
          "max_tracks": {
            "type": "integer"
          }
        },
        "required": [
          "brief"
        ],
        "type": "object"
      },
      "name": "build_dj_crate"
    },
